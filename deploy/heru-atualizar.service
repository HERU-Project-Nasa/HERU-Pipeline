[Unit]
Description=HERU-Pipeline atualizar
Wants=network-online.target
After=network-online.target

[Service]
User=heru
Group=heru
WorkingDirectory=/srv/heru/HERU-Pipeline
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/heru/HERU-Pipeline/.venv/bin/python -m heru atualizar --a-cada 10 --tiles --horas-tiles 3 --minutos-pontos 15 --processos 3
Restart=always
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=120
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
